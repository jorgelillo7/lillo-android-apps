<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only to download the public events file (jorgelillo7.github.io/stadium/events.json). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The reminder the evening before a busy day. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".StadiumEventsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/lillo_data_extraction_rules"
        android:fullBackupContent="@xml/lillo_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StadiumEvents">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StadiumEvents.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.JaleoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jaleo_widget_info" />
        </receiver>
    </application>

</manifest>
