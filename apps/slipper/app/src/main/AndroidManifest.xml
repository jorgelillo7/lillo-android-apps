<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions: the game runs on the phone, and challenges travel inside links. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".SlipperApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/lillo_data_extraction_rules"
        android:fullBackupContent="@xml/lillo_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slipper">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Slipper.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Challenge links ("can you beat 1,240?"). Verified with /.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="jorgelillo7.github.io" />
                <data android:pathPrefix="/c" />
            </intent-filter>
            <!-- "Share to app" from a chat: works even before the link above is verified. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
