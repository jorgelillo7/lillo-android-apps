<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device transfer for apps that keep their state in DataStore (JsonStore,
  preferences): only files/datastore/ travels to a new phone. Anything else (WorkManager's
  database, caches, shared images) is rebuilt by the app and must not be restored.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
