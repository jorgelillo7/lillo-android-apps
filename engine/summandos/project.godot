; Summandos (ES "Sumandos"): a shooting squad grown by maths gates. Plan: docs/plans/fake-ad-games.md
config_version=5

[application]

config/quit_on_go_back=false

config/name="Summandos"
config/features=PackedStringArray("4.7", "Mobile")
run/main_scene="res://main.tscn"
config/version="1.0"
config/icon="res://assets/icons/main_192.png"

[display]

; Upright and turned sideways: the layout adapts, never stretches or crops.
window/size/viewport_width=720
window/size/viewport_height=720
window/handheld/orientation=6
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
