# Formatting, enforced by Spotless + ktlint (./gradlew spotlessApply / spotlessCheck, CI "Lint").
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = android_studio
# Composables are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Long lines are left as they are for now (PENDING.md: bring them under a limit file by file).
max_line_length = off
