# Formatting, enforced by Spotless + ktlint with the community Compose rules
# (io.nlopez.compose.rules): ./gradlew spotlessApply / spotlessCheck, CI "Lint".
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = android_studio
# Composables are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# 120 columns: the Android Kotlin style guide says 100; 120 keeps Compose call chains readable.
max_line_length = 120
